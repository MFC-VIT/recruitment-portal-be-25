PORT=5000
CONNECT_STRING=mongodb+srv://...

# Signs access tokens (1 day). The misspelling is load-bearing, keep it.
ACCESS_TOKEN_SECERT=
# Signs refresh tokens (15 days). Must differ from ACCESS_TOKEN_SECERT.
REFRESH_TOKEN_SECRET=

# Gmail account + app password used for OTP / reset mails
AUTH_EMAIL=
AUTH_PASS=
# Gmail account + app password used for interview mails
MFC_EMAIL=
MFC_EMAIL_PASSWORD=

CLIENT_URL=https://<candidate frontend>

# Google Calendar OAuth. Connect once by opening, while logged in as admin:
#   <backend>/api/meet/auth?token=<admin access token>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=<backend>/api/meet/oauth/callback

# Interview panels: interviewers per panel once the interviewers collection is set up
PANEL_SIZE=2
# Reminders run every 5 min in-process; set to true to rely only on the cron endpoint
DISABLE_REMINDERS=false
# Shared secret for POST /api/meet/reminders/run (X-Cron-Secret header)
CRON_SECRET=

# Web Push (npx web-push generate-vapid-keys). Same pair on the admin backend.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Sign in with GitHub (OAuth App, callback = <candidate frontend>/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Org invites for accepted offers (fine-grained token: Members read/write)
GITHUB_ORG=
GITHUB_ORG_TOKEN=
# Encrypts stored GitHub tokens; defaults to a key derived from ACCESS_TOKEN_SECERT
SECRET_BOX_KEY=
